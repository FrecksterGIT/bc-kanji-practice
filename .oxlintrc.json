{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "warn",
    "react/refs": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  }
}
